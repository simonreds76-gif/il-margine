      "filters": {
        "league": ["ATP"],
        "surface": ["Hard"],
        "series": ["ATP250", "ATP500", "Masters1000", "ATPFinals"],
        "best_of": [3],
        "exclude_grand_slams": true
      },
      "markets": {
        "ml": { "state": "existing", "edge_pct": [4, 12], "confidence": ["high"] },
        "fav_hc": { "state": "future_controlled" },
        "over_games": { "state": "future_shadow" }
      },
      "calibration": {
        "path": "data/backtest/calibration/_fallback.json",
