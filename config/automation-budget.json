{
  "schema_version": 1,
  "provider_limits": {
    "odds_api_io": {
      "label": "Odds-API.io free plan",
      "requests_per_hour": 100,
      "requests_per_day": 500,
      "bookmaker_scope": "recreational only",
      "effective_from": "2026-07-26",
      "source": "https://docs.odds-api.io/changelog#free-tier-changes"
    },
    "api_football": {
      "label": "API-Football free-plan allowance",
      "requests_per_day": 100,
      "source": "repository hard cap"
    }
  },
  "github_workflows": [
    {
      "file": "assist-value-shadow.yml",
      "models": ["assist_v1"],
      "season_gate": "August-May",
      "database_mode": "none",
      "db_reads_max_per_run": 0,
      "db_writes_max_per_run": 0,
      "schedules": [
        {
          "cron": "10 7 * * 0,5,6",
          "request_caps": {"odds_api_io": 10}
        }
      ]
    },
    {
      "file": "club-penalty-weekly-evidence.yml",
      "models": ["club_penalty_evidence"],
      "season_gate": "always",
      "database_mode": "none",
      "db_reads_max_per_run": 0,
      "db_writes_max_per_run": 0,
      "schedules": [
        {"cron": "20 0 * * *", "request_caps": {}},
        {"cron": "20 6 * * 1", "request_caps": {}}
      ]
    },
    {
      "file": "goalscorer-expected-refresh.yml",
      "models": ["goalscorer_v2", "fair_odds_lab"],
      "season_gate": "August-May with no-fixture-safe outputs",
      "database_mode": "blob_publish_with_optional_snapshot_upload",
      "db_reads_max_per_run": 0,
      "db_writes_max_per_run": 2,
      "schedules": [
        {"cron": "45 6 * * *", "request_caps": {"odds_api_io": 15}}
      ]
    },
    {
      "file": "goalscorer-hot-live.yml",
      "models": ["goalscorer_v2", "fair_odds_lab"],
      "season_gate": "fixture-window gate per league",
      "database_mode": "close_tier_only_with_optional_snapshot_upload",
      "db_reads_max_per_run": 0,
      "db_writes_max_per_run": 7,
      "schedules": [
        {"cron": "10 10-22 * * *", "request_caps": {"odds_api_io": 15}},
        {
          "cron": "40 10-22 * * *",
          "request_caps": {},
          "db_reads_max_per_run": 0,
          "db_writes_max_per_run": 0
        }
      ]
    },
    {
      "file": "goalscorer-settlement.yml",
      "models": ["goalscorer_v2", "fair_odds_lab", "club_penalty_evidence"],
      "season_gate": "August-May",
      "database_mode": "settlement_read_with_optional_snapshot_upload",
      "db_reads_max_per_run": 2,
      "db_writes_max_per_run": 2,
      "schedules": [
        {"cron": "45 8 * * *", "request_caps": {}}
      ]
    },
    {
      "file": "football-counts-vnext-shadow.yml",
      "models": ["team_shots_v4", "corners_v3", "team_fouls_f2"],
      "season_gate": "from 2026-08-01",
      "database_mode": "none",
      "db_reads_max_per_run": 0,
      "db_writes_max_per_run": 0,
      "schedules": [
        {
          "cron": "15 8 * * *",
          "request_caps": {"odds_api_io": 50, "api_football": 90}
        },
        {
          "cron": "45 9-22 * * *",
          "request_caps": {"odds_api_io": 9}
        }
      ]
    },
    {
      "file": "ops-alert-check.yml",
      "models": ["operations_health"],
      "season_gate": "always",
      "database_mode": "read_with_conditional_orphan_cleanup",
      "db_reads_max_per_run": 2,
      "db_writes_max_per_run": 1,
      "schedules": [
        {"cron": "15 * * * *", "request_caps": {}}
      ]
    },
    {
      "file": "pinnacle-capture-history.yml",
      "models": ["tennis_ml_clv", "tennis_spread_clv"],
      "season_gate": "always",
      "database_mode": "append_only_history_and_run_status",
      "db_reads_max_per_run": 0,
      "db_writes_max_per_run": 3,
      "schedules": [
        {"cron": "*/30 * * * *", "request_caps": {}}
      ]
    },
    {
      "file": "team-fouls-source-agreement.yml",
      "models": ["team_fouls_f2"],
      "season_gate": "always",
      "database_mode": "none",
      "db_reads_max_per_run": 0,
      "db_writes_max_per_run": 0,
      "schedules": [
        {"cron": "35 7 * * *", "request_caps": {}}
      ]
    },
    {
      "file": "tennis-props-bet365-refresh.yml",
      "models": ["tennis_aces", "tennis_double_faults"],
      "season_gate": "main-tour events only",
      "database_mode": "none",
      "db_reads_max_per_run": 0,
      "db_writes_max_per_run": 0,
      "schedules": [
        {"cron": "25 8 * * *", "request_caps": {"odds_api_io": 8}},
        {"cron": "25 11 * * *", "request_caps": {"odds_api_io": 8}, "conditional": "skip when the morning file has usable rows"},
        {"cron": "25 15 * * *", "request_caps": {"odds_api_io": 8}}
      ]
    },
    {
      "file": "weekly-research-report.yml",
      "models": ["all_model_evidence"],
      "season_gate": "always",
      "database_mode": "read_only_with_local_fallback",
      "db_reads_max_per_run": 6,
      "db_writes_max_per_run": 0,
      "schedules": [
        {"cron": "30 11 * * 2", "request_caps": {}}
      ]
    }
  ],
  "local_windows_tasks": [
    {"name": "IlMargine-Daily", "schedule": "daily 22:30 local", "models": ["tennis_all"], "database_mode": "quick_sync_and_append_only_clv"},
    {"name": "IlMargine-Daily-AM", "schedule": "daily 10:05 local", "models": ["tennis_all"], "database_mode": "quick_sync_and_append_only_clv"},
    {"name": "IlMargine-Tennis-Close-Capture", "schedule": "daily 08:00 local", "models": ["tennis_clv"], "database_mode": "append_only_clv"},
    {"name": "IlMargine-Tennis-Health-AM", "schedule": "daily 11:15 local", "models": ["tennis_health"], "database_mode": "none"},
    {"name": "IlMargine-Tennis-Health-PM", "schedule": "daily 23:15 local", "models": ["tennis_health"], "database_mode": "none"},
    {"name": "IlMargine-Weekly", "schedule": "Sunday 03:00 local", "models": ["tennis_weekly_research"], "database_mode": "full_sync_and_read_only_clv_audits"}
  ]
}
