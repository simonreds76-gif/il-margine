{"LeagueInfo": [37, "England Championship", "2026-2027", "#cc3300", "league_match/images/16667499415.png", "ENG LCH", "The&nbsp;English&nbsp;Championship&nbsp;League&nbsp;consists&nbsp;of&nbsp;24&nbsp;teams&nbsp;and&nbsp;operates&nbsp;on&nbsp;a&nbsp;double&nbsp;round-robin&nbsp;format&nbsp;(each&nbsp;team&nbsp;plays&nbsp;every&nbsp;other&nbsp;team&nbsp;twice,&nbsp;once&nbsp;at&nbsp;home&nbsp;and&nbsp;once&nbsp;away).&nbsp;In&nbsp;a&nbsp;single&nbsp;match,&nbsp;the&nbsp;points&nbsp;system&nbsp;is&nbsp;as&nbsp;follows:&nbsp;the&nbsp;winner&nbsp;receives&nbsp;3&nbsp;points,&nbsp;the&nbsp;loser&nbsp;receives&nbsp;0&nbsp;points,&nbsp;and&nbsp;in&nbsp;case&nbsp;of&nbsp;a&nbsp;draw,&nbsp;each&nbsp;team&nbsp;earns&nbsp;1&nbsp;point.&nbsp;At&nbsp;the&nbsp;end&nbsp;of&nbsp;the&nbsp;season,&nbsp;teams&nbsp;are&nbsp;ranked&nbsp;based&nbsp;on&nbsp;their&nbsp;accumulated&nbsp;points;&nbsp;in&nbsp;the&nbsp;event&nbsp;of&nbsp;a&nbsp;tie&nbsp;in&nbsp;points,&nbsp;ranking&nbsp;is&nbsp;determined&nbsp;by&nbsp;goal&nbsp;difference&nbsp;and&nbsp;total&nbsp;goals&nbsp;scored.&nbsp;The&nbsp;top&nbsp;two&nbsp;teams&nbsp;in&nbsp;the&nbsp;Championship&nbsp;League&nbsp;are&nbsp;promoted&nbsp;directly&nbsp;to&nbsp;the&nbsp;Premier&nbsp;League,&nbsp;while&nbsp;teams&nbsp;finishing&nbsp;third&nbsp;through&nbsp;eighth&nbsp;place&nbsp;compete&nbsp;in&nbsp;a&nbsp;play-off&nbsp;for&nbsp;promotion.&nbsp;The&nbsp;third-&nbsp;and&nbsp;fourth-placed&nbsp;teams&nbsp;advance&nbsp;directly&nbsp;to&nbsp;the&nbsp;semi-finals,&nbsp;whereas&nbsp;the&nbsp;fifth-&nbsp;and&nbsp;sixth-placed&nbsp;teams&nbsp;first&nbsp;face&nbsp;the&nbsp;seventh-&nbsp;and&nbsp;eighth-placed&nbsp;teams,&nbsp;with&nbsp;the&nbsp;winners&nbsp;then&nbsp;facing&nbsp;the&nbsp;third-&nbsp;and&nbsp;fourth-placed&nbsp;teams&nbsp;in&nbsp;a&nbsp;final&nbsp;showdown&nbsp;for&nbsp;a&nbsp;promotion&nbsp;spot.&nbsp;Teams&nbsp;are&nbsp;determined&nbsp;by&nbsp;a&nbsp;draw&nbsp;to&nbsp;be&nbsp;the&nbsp;home&nbsp;side&nbsp;first;&nbsp;the&nbsp;play-off&nbsp;semifinals&nbsp;are&nbsp;played&nbsp;as&nbsp;two-legged&nbsp;home-and-away&nbsp;ties.&nbsp;If&nbsp;the&nbsp;aggregate&nbsp;score&nbsp;across&nbsp;both&nbsp;legs&nbsp;remains&nbsp;tied,&nbsp;extra&nbsp;time&nbsp;is&nbsp;played,&nbsp;and&nbsp;if&nbsp;the&nbsp;score&nbsp;is&nbsp;still&nbsp;level&nbsp;after&nbsp;extra&nbsp;time,&nbsp;penalty&nbsp;shootouts&nbsp;determine&nbsp;the&nbsp;winner.&nbsp;The&nbsp;two&nbsp;winning&nbsp;teams&nbsp;will&nbsp;then&nbsp;compete&nbsp;in&nbsp;a&nbsp;single-match&nbsp;final&nbsp;at&nbsp;a&nbsp;neutral&nbsp;venue&nbsp;to&nbsp;vie&nbsp;for&nbsp;the&nbsp;championship,&nbsp;and&nbsp;the&nbsp;champion&nbsp;team&nbsp;will&nbsp;be&nbsp;promoted&nbsp;to&nbsp;the&nbsp;Premier&nbsp;League.&nbsp;Additionally,&nbsp;the&nbsp;bottom&nbsp;three&nbsp;teams&nbsp;in&nbsp;the&nbsp;Championship&nbsp;League&nbsp;will&nbsp;be&nbsp;relegated&nbsp;to&nbsp;League&nbsp;One.", 0], "TeamInfo": [[17, "Middlesbrough", "", "images/17/1m01grww031d.png", 0], [18, "West Bromwich(WBA)", "", "images/18/1m01grwvhq2h.png", 0], [21, "Blackburn Rovers", "", "images/21/1kzyydvms72g.png", 0], [22, "Bolton Wanderers", "", "images/22/1m01gsb41t1f.png", 0], [23, "Charlton Athletic", "", "images/23/1m01grww062j.png", 0], [30, "Southampton", "", "images/30/1m0473hwd92z.png", 0], [32, "Birmingham City", "", "images/32/1m01grwvhv1e.png", 0], [34, "Norwich City", "", "images/34/1m01grww0k2v.png", 0], [36, "Portsmouth", "", "images/36/1m01gs45dn1c.png", 0], [46, "Burnley", "", "images/46/1m0473hwde1a.png", 0], [47, "Derby County", "", "images/47/1m01gs45d42a.png", 0], [50, "Queens Park Rangers (QPR)", "", "images/50/1m01gs45dwj.png", 0], [51, "Sheffield United", "", "images/51/1m01gs45d7p.png", 0], [52, "Wolves", "", "images/52/1kzyydvmsva.png", 0], [53, "Watford", "", "images/53/1m0473jwmv2q.png", 0], [55, "Preston North End", "", "images/55/1m01gs45d2x.png", 0], [58, "Stoke City", "", "images/58/1m01gsb4162t.png", 0], [62, "West Ham United", "", "images/62/1m0473jwmh23.png", 